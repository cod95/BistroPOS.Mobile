<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             x:Class="BistroPOS.Mobile.OrderPage"
             Title="طلبية جديدة">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <Button Grid.Row="0"
                Text="← رجوع للرئيسية"
                BackgroundColor="#444444"
                TextColor="White"
                Margin="10,10,10,0"
                Clicked="OnBackClicked"/>

        <VerticalStackLayout Grid.Row="1" Padding="10,10,10,0" Spacing="8">
            <HorizontalStackLayout Spacing="10">
                <Switch x:Name="DeferredSwitch" Toggled="OnDeferredToggled"/>
                <Label Text="فاتورة مؤجلة (الزبون لسا ما دفع)"
                       VerticalOptions="Center"
                       FontAttributes="Bold"/>
            </HorizontalStackLayout>

            <Entry x:Name="TableEntry"
                   Placeholder="اسم الزبون أو رقم الطاولة"
                   IsVisible="False"/>

            <Entry x:Name="DiscountEntry"
                   Placeholder="الحسم بالليرة (اختياري)"
                   Keyboard="Numeric"/>
        </VerticalStackLayout>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="10,10,10,0" ColumnSpacing="8">
            <Entry x:Name="SearchEntry"
                   Grid.Column="0"
                   Placeholder="🔍 بحث عن صنف بالاسم..."/>
            <Button Grid.Column="1"
                    Text="📷"
                    WidthRequest="46"
                    FontSize="18"
                    BackgroundColor="#3C78B4"
                    TextColor="White"
                    Clicked="OnScanBarcodeClicked"/>
        </Grid>

        <ScrollView Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="10,8,10,0"
                    HeightRequest="44">
            <HorizontalStackLayout x:Name="CategoryStack" Spacing="8"/>
        </ScrollView>

        <CollectionView x:Name="MenuCollectionView"
                        Grid.Row="4"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,Auto,Auto,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                               Text="{Binding Name}"
                               FontAttributes="Bold" FontSize="16"/>

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding Price, StringFormat='{0:N0} ل.ل'}"
                               VerticalOptions="Center"/>

                        <Button Grid.Row="1" Grid.Column="1"
                                Text="-" WidthRequest="40"
                                Clicked="OnDecreaseClicked"/>

                        <Label Grid.Row="1" Grid.Column="2"
                               Text="{Binding Quantity}"
                               WidthRequest="30"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"/>

                        <Button Grid.Row="1" Grid.Column="3"
                                Text="+" WidthRequest="40"
                                BackgroundColor="#FF6B00" TextColor="White"
                                Clicked="OnIncreaseClicked"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="5" Padding="15" BackgroundColor="#F5F5F5">
            <Label x:Name="TotalLabel"
                   Text="الإجمالي: 0 ل.ل"
                   FontAttributes="Bold" FontSize="18"
                   HorizontalOptions="Center"/>

            <Button Text="إرسال الطلبية"
                    BackgroundColor="#FF6B00" TextColor="White"
                    FontAttributes="Bold" Margin="0,10,0,0"
                    Clicked="OnSubmitOrderClicked"/>
        </VerticalStackLayout>

        <Grid x:Name="ScannerOverlay"
              Grid.Row="0" Grid.RowSpan="6"
              IsVisible="False"
              BackgroundColor="Black">
            <scanner:CameraView x:Name="ScannerCameraView"
                                 CameraEnabled="False"
                                 OnDetectionFinished="CameraView_OnDetectionFinished"/>
            <VerticalStackLayout VerticalOptions="Start" Padding="20" Spacing="10">
                <Button Text="✕ إغلاق الماسح"
                        BackgroundColor="#A01E1E"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="OnCloseScannerClicked"/>
                <Label Text="وجّه الكاميرا نحو الباركود"
                       TextColor="White"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
