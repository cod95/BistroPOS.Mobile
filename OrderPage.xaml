<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BistroPOS.Mobile.OrderPage"
             Title="طلبية جديدة">

    <Grid RowDefinitions="Auto,*,Auto">

        <Button Grid.Row="0"
                Text="← رجوع للرئيسية"
                BackgroundColor="#444444"
                TextColor="White"
                Margin="10,10,10,0"
                Clicked="OnBackClicked"/>

        <CollectionView x:Name="MenuCollectionView"
                        Grid.Row="1"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*,Auto,Auto,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                               Text="{Binding Name}"
                               FontAttributes="Bold" FontSize="16"/>

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding Price, StringFormat='{0:N0} ل.ل'}"
                               VerticalOptions="Center"/>

                        <Button Grid.Row="1" Grid.Column="1"
                                Text="-" WidthRequest="40"
                                Clicked="OnDecreaseClicked"/>

                        <Label Grid.Row="1" Grid.Column="2"
                               Text="{Binding Quantity}"
                               WidthRequest="30"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"/>

                        <Button Grid.Row="1" Grid.Column="3"
                                Text="+" WidthRequest="40"
                                BackgroundColor="#FF6B00" TextColor="White"
                                Clicked="OnIncreaseClicked"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Padding="15" BackgroundColor="#F5F5F5">
            <Label x:Name="TotalLabel"
                   Text="الإجمالي: 0 ل.ل"
                   FontAttributes="Bold" FontSize="18"
                   HorizontalOptions="Center"/>

            <Button Text="إرسال الطلبية"
                    BackgroundColor="#FF6B00" TextColor="White"
                    FontAttributes="Bold" Margin="0,10,0,0"
                    Clicked="OnSubmitOrderClicked"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
