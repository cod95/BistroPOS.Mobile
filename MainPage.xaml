<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BistroPOS.Mobile.MainPage"
             Title="الرئيسية">
    <StackLayout Padding="30" VerticalOptions="Center">
        <Label x:Name="WelcomeLabel"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#FF6B00"/>
        <Label x:Name="RoleLabel"
               FontSize="16"
               HorizontalOptions="Center"
               Margin="0,10,0,30"/>
        <Button Text="طلبية جديدة"
                BackgroundColor="#FF6B00"
                TextColor="White"
                FontAttributes="Bold"
                Margin="0,10,0,0"
                Clicked="OnNewOrderClicked"/>
        <Button x:Name="OrdersButton"
                Text="الطلبات"
                BackgroundColor="#3C78B4"
                TextColor="White"
                FontAttributes="Bold"
                Margin="0,10,0,0"
                Clicked="OnOrdersClicked"/>
        <Button x:Name="ReportsButton"
                Text="التقارير"
                BackgroundColor="#8E44AD"
                TextColor="White"
                FontAttributes="Bold"
                Margin="0,10,0,0"
                IsVisible="False"
                Clicked="OnReportsClicked"/>
        <Button Text="تسجيل خروج"
                BackgroundColor="#444444"
                TextColor="White"
                Margin="0,10,0,0"
                Clicked="OnLogoutClicked"/>
    </StackLayout>
</ContentPage>
