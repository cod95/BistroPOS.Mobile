<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BistroPOS.Mobile.MainPage"
             Title="الرئيسية"
             BackgroundColor="#F5F5F3">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0"
                              BackgroundColor="#1C1C1A"
                              Padding="24,36,24,28"
                              Spacing="4">
            <Label Text="BistroPOS"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#DAA520"
                   HorizontalOptions="Center"/>
            <Label x:Name="WelcomeLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0"/>
            <Label x:Name="RoleLabel"
                   FontSize="13"
                   TextColor="#B4B4B4"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="24,24" Spacing="14" VerticalOptions="Center">

            <Button Text="🧾  طلبية جديدة"
                    BackgroundColor="#FF6B00"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="56"
                    Clicked="OnNewOrderClicked"/>

            <Button x:Name="OrdersButton"
                    Text="📋  الطلبات"
                    BackgroundColor="#3C78B4"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="56"
                    Clicked="OnOrdersClicked"/>

            <Button x:Name="ReportsButton"
                    Text="📊  التقارير"
                    BackgroundColor="#8E44AD"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="56"
                    IsVisible="False"
                    Clicked="OnReportsClicked"/>

            <Button x:Name="DebtsButton"
                    Text="💳  الزبائن والديون"
                    BackgroundColor="#16A085"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="56"
                    IsVisible="False"
                    Clicked="OnDebtsClicked"/>

            <BoxView HeightRequest="1" BackgroundColor="#DDDDDD" Margin="0,10"/>

            <Button Text="🚪  تسجيل خروج"
                    BackgroundColor="#444444"
                    TextColor="White"
                    FontSize="15"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="OnLogoutClicked"/>

        </VerticalStackLayout>

    </Grid>
</ContentPage>
