<Shell x:Class="BistroPOS.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:BistroPOS.Mobile"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate local:LoginPage}" />
    <ShellContent Route="MainPage" ContentTemplate="{DataTemplate local:MainPage}" />
    <ShellContent Route="OrderPage" ContentTemplate="{DataTemplate local:OrderPage}" />
    <ShellContent Route="OrdersPage" ContentTemplate="{DataTemplate local:OrdersPage}" />
    <ShellContent Route="ReportsPage" ContentTemplate="{DataTemplate local:ReportsPage}" />

</Shell>
